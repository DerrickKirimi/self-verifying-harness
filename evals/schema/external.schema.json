{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference-only external temporal-media task with observed native oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "source", "app", "media", "review", "claims", "oracle"],
  "properties": {
    "format": {"const": "svh.external.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "revision", "instance_id", "row_path", "row_sha256"],
      "properties": {
        "dataset": {"const": "SWE-bench/SWE-bench_Multimodal"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "instance_id": {"type": "string"},
        "row_path": {"type": "string"},
        "row_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "app": {
      "type": "object", "additionalProperties": false,
      "required": ["repo", "base_commit", "fix_patch_sha256", "test_patch_sha256", "image"],
      "properties": {
        "repo": {"type": "string"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fix_patch_sha256": {"$ref": "#/$defs/hash"},
        "test_patch_sha256": {"$ref": "#/$defs/hash"},
        "image": {"type": "string", "pattern": "^swebench/[a-z0-9._-]+@sha256:[0-9a-f]{64}$"}
      }
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "source_url", "duration_s", "has_audio", "kind"],
      "properties": {
        "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"},
        "source_url": {"type": "string", "format": "uri"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "has_audio": {"type": "boolean"},
        "kind": {"enum": ["video", "animated_image"]}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "interval_s", "screening", "distribution", "reviewed_at"],
      "properties": {
        "method": {"const": "contact-sheet"},
        "interval_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "screening": {"const": "no-sensitive-content-observed"},
        "distribution": {"const": "reference-only"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "t_start_s", "t_end_s", "text", "evidence_mode", "expected_tests"],
        "properties": {
          "id": {"type": "string"},
          "t_start_s": {"type": "number", "minimum": 0},
          "t_end_s": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": "string", "minLength": 10},
          "evidence_mode": {"const": "shown"},
          "expected_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["runner", "report_path", "report_sha256"],
      "properties": {
        "runner": {"const": "swebench-karma"},
        "report_path": {"type": "string"},
        "report_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
